<IfModule mod_rewrite.c>
  RewriteEngine On

  # The Laravel API is a separately managed Hostinger directory. Keep it out
  # of SPA routing even when the host does not report it as a normal directory.
  RewriteRule ^api(?:/|$) - [L]

  # Never turn a missing production asset into HTML. Module and media requests
  # must fail as real 404 responses so browsers do not cache index.html as a file.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/(?:assets|images)/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.[a-z0-9]{2,8}$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^admin(?:/.*)?$ admin.html [L]
  RewriteRule . index.html [L]
</IfModule>
