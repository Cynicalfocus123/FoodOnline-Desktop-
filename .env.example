APP_NAME="FoodOnlines.com"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
ADMIN_NAME="FoodOnlines Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_CONTACT_NUMBER="0000000000"
ADMIN_COMPANY_NAME="FoodOnlines.com"

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodonlines
DB_USERNAME=foodonlines_user
DB_PASSWORD=

QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mail.foodonlines.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@foodonlines.com"
MAIL_FROM_NAME="${APP_NAME}"
