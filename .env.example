APP_NAME="FoodOnlines.com"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.api.foodonlines.com
FRONTEND_URL=https://www.foodonlines.com
FOODONLINES_CATALOG_CURRENCY=USD
MEDIA_DISK=local
MEDIA_UPLOADS_ENABLED=true
MEDIA_PUBLIC_URL=https://api.foodonlines.com/api/media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=https://media.foodonlines.com
R2_PATH_STYLE_ENDPOINT=false
R2_UPLOAD_URL_TTL_MINUTES=5
APP_TIMEZONE=UTC
ADMIN_NAME="FoodOnlines Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_CONTACT_NUMBER="0000000000"
ADMIN_COMPANY_NAME="FoodOnlines.com"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodonlines
DB_USERNAME=foodonlines_user
DB_PASSWORD=

QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

USER_TOKEN_TTL_MINUTES=43200
ADMIN_TOKEN_TTL_MINUTES=480

COMMERCE_CURRENCY=USD
COMMERCE_SHIPPING_ENABLED=true
COMMERCE_STANDARD_SHIPPING_MINOR=599
COMMERCE_FREE_SHIPPING_THRESHOLD_MINOR=4900
COMMERCE_SUPPORTED_COUNTRIES=thailand,japan,singapore,taiwan,china,philippines,malaysia,indonesia,hongKong
COMMERCE_COD_ENABLED=true
COMMERCE_COD_FEE_MINOR=0
COMMERCE_COD_MINIMUM_MINOR=0
COMMERCE_COD_MAXIMUM_MINOR=
COMMERCE_COD_COUNTRIES=thailand,japan,singapore,taiwan,china,philippines,malaysia,indonesia,hongKong
COMMERCE_GUEST_CHECKOUT_ENABLED=true
COMMERCE_RESERVATION_MINUTES=30
COMMERCE_QUOTE_MINUTES=15
COMMERCE_ORDER_CANCELLATION_MINUTES=60
COMMERCE_TAX_MODE=disabled
COMMERCE_FLAT_TAX_BASIS_POINTS=0
COMMERCE_ORDER_SUPPORT_EMAIL=support@foodonlines.com
COMMERCE_ORDER_NOTIFICATION_EMAIL=orders@foodonlines.com
COMMERCE_RETURN_WINDOW_DAYS=14
RETENTION_GUEST_CART_DAYS=30
RETENTION_QUOTE_DAYS=30
RETENTION_NOTIFICATION_DAYS=180
RETENTION_FAILED_JOB_DAYS=90
RETENTION_EXPORT_DAYS=7
RETENTION_MEDIA_UPLOAD_DAYS=30

MAIL_MAILER=smtp
MAIL_HOST=mail.foodonlines.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@foodonlines.com"
MAIL_FROM_NAME="${APP_NAME}"
