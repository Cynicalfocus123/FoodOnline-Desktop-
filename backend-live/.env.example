APP_NAME="FoodOnlines.com"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.api.foodonlines.com
FRONTEND_URL=https://www.foodonlines.com
FOODONLINES_CATALOG_CURRENCY=USD
APP_TIMEZONE=UTC
ADMIN_NAME="FoodOnlines Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_CONTACT_NUMBER="0000000000"
ADMIN_COMPANY_NAME="FoodOnlines.com"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodonlines
DB_USERNAME=foodonlines_user
DB_PASSWORD=

QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

USER_TOKEN_TTL_MINUTES=43200
ADMIN_TOKEN_TTL_MINUTES=480

MAIL_MAILER=smtp
MAIL_HOST=mail.foodonlines.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@foodonlines.com"
MAIL_FROM_NAME="${APP_NAME}"
