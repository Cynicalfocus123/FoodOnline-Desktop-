{
  "project": {
    "name": "FoodOnlines Desktop Web",
    "version": "1.0.0",
    "updated_at": "2026-05-24",
    "notes": "Desktop design memory file for public storefront UI structure and backend-ready mock bindings."
  },
  "sources": {
    "desktop_notes": "D:/Foodonline desktop version/design.md",
    "desktop_agent": "D:/Foodonline desktop version/AGENT.md",
    "mobile_reference_designer": "D:/Thai app food online/App/designer.md",
    "mobile_reference_design_json": "D:/Thai app food online/App/design.json"
  },
  "routes": {
    "home": {
      "path": "#home",
      "view": "home"
    },
    "login": {
      "path": "#login",
      "view": "login"
    },
    "category_listing": {
      "path": "#category/:categorySlug",
      "view": "category",
      "refresh_safe": true
    },
    "product_detail": {
      "path": "#product/:productId",
      "view": "product",
      "refresh_safe": true
    }
  },
  "components": {
    "product_detail_page": {
      "file": "src/components/ProductDetailPage.tsx",
      "sections": [
        "gallery",
        "price_and_purchase_panel",
        "shipping_address_card",
        "details_tabs",
        "similar_items_rail",
        "reviews_summary",
        "reviews_full_modal"
      ],
      "gallery_behavior": {
        "boxed_card_removed": true,
        "image_fit": "contain",
        "navigation": "pagination_dots_only",
        "drag_scroll_supported": true
      },
      "cart_behavior": {
        "cta_color": "green",
        "quantity_control": [
          "trash_at_1",
          "minus_above_1",
          "center_count",
          "plus_on_right"
        ]
      }
    },
    "product_card": {
      "file": "src/components/ProductCard.tsx",
      "behaviors": [
        "open_product_detail",
        "favorite_toggle",
        "shared_quantity_control",
        "category_grid_reuse"
      ],
      "category_listing_compact_mode": {
        "shorter_than_homepage_rail": true,
        "image_priority": "square",
        "cart_control_position": "image_overlay_bottom_right",
        "price_row": "inline_compact"
      },
      "layout_alignment": {
        "equal_width_per_breakpoint": true,
        "shared_min_height_per_row": true,
        "reserved_internal_rows": [
          "badge_band",
          "brand_label",
          "title_block",
          "size_text",
          "unit_price_text",
          "price_and_action_footer"
        ],
        "title_clamp": 2,
        "trimmed_vertical_spacing": true
      },
      "quantity_css": {
        "stable_pill_width": true,
        "nowrap_text": true,
        "responsive_card_safe": true,
        "full_width_bottom_row": true
      }
    },
    "category_listing_page": {
      "file": "src/components/CategoryListingPage.tsx",
      "desktop_layout": "left_filter_sidebar_right_product_grid",
      "mobile_layout": "filter_drawer_plus_responsive_grid",
      "narrow_control_style": "small_inline_filter_sort_triggers",
      "grid_columns": {
        "desktop": 5,
        "tablet": 3,
        "mobile": 2
      },
      "initial_product_count_per_category": 60,
      "sorting_options": [
        "Featured (default)",
        "Best Selling",
        "Price: Low to High",
        "Price: High to Low"
      ],
      "filter_sections": [
        "Delivery type",
        "Product type",
        "Made in",
        "Price",
        "Price Range",
        "Brand"
      ]
    },
    "header_cart": {
      "file": "src/components/Header.tsx",
      "badge_behavior": [
        "shared_cart_total",
        "desktop_badge",
        "mobile_badge",
        "hide_when_zero"
      ]
    },
    "cart_quantity_control": {
      "file": "src/components/CartQuantityControl.tsx",
      "states": [
        "add_to_cart",
        "trash_at_quantity_one",
        "minus_above_one",
        "plus_increment"
      ],
      "visual_style": "green_pill"
    }
  },
  "responsive_rules": {
    "desktop": {
      "top_layout": "two_column",
      "gallery": "left",
      "purchase_panel": "sticky_right",
      "similar_items": "horizontal_multi_card"
    },
    "desktop_mobile_browser": {
      "top_layout": "collapse_without_overflow",
      "tabs": "horizontal_scroll",
      "reviews_modal": "resize_cleanly",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "filter_drawer_no_clipping"
    },
    "tablet": {
      "top_layout": "two_column_if_space_else_stack",
      "controls": "touch_friendly",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "three_column_grid"
    },
    "mobile": {
      "top_layout": "stacked",
      "gallery": "top",
      "reviews_view": "bottom_sheet_style",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "two_column_grid_with_filter_drawer"
    }
  },
  "data_bindings": {
    "catalog_file": "src/data/home.ts",
    "store_file": "src/store/homeStore.ts",
    "fields": [
      "id",
      "name",
      "categorySlug",
      "imageUrls",
      "price",
      "oldPrice",
      "discountPercent",
      "unitPrice",
      "soldCount",
      "categoryId",
      "categoryName",
      "deliveryType",
      "productType",
      "madeIn",
      "tags",
      "badges",
      "provider",
      "country",
      "countryOfOrigin",
      "brandOrigin",
      "netContent",
      "quantity",
      "description",
      "ingredients",
      "storageInstructions",
      "sku",
      "recipeSuggestions",
      "nutritionFacts",
      "returnPolicy",
      "reviews",
      "reviewTags",
      "ratingBreakdown",
      "variants"
    ],
    "shared_state": [
      "selectedProductId",
      "selectedCategorySlug",
      "cartQuantities",
      "favoriteProductIds",
      "selectedZipCode"
    ]
  },
  "tests": {
    "commands": [
      "cmd /c npx tsc --noEmit",
      "cmd /c npm run build"
    ],
    "git_commit_hash": "pending"
  }
}
