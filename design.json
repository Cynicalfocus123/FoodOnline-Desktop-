{
  "project": {
    "name": "FoodOnlines Desktop Web",
    "version": "1.0.0",
    "updated_at": "2026-05-26",
    "notes": "Desktop design memory file for public storefront UI structure and backend-ready mock bindings."
  },
  "sources": {
    "desktop_notes": "D:/Foodonline desktop version/design.md",
    "desktop_agent": "D:/Foodonline desktop version/AGENT.md",
    "mobile_reference_designer": "D:/Thai app food online/App/designer.md",
    "mobile_reference_design_json": "D:/Thai app food online/App/design.json"
  },
  "routes": {
    "home": {
      "path": "#home",
      "view": "home"
    },
    "login": {
      "path": "#login",
      "view": "login"
    },
    "cart": {
      "path": "#cart",
      "view": "cart",
      "refresh_safe": true
    },
    "checkout": {
      "path": "#checkout",
      "view": "checkout",
      "refresh_safe": true
    },
    "category_listing": {
      "path": "#category/:categorySlug",
      "view": "category",
      "refresh_safe": true
    },
    "product_detail": {
      "path": "#product/:productId",
      "view": "product",
      "refresh_safe": true
    },
    "search_results": {
      "path": "#search/:query",
      "view": "search",
      "refresh_safe": true
    }
  },
  "components": {
    "shortcut_row": {
      "file": "src/components/ShortcutRow.tsx",
      "rendered_on_homepage": false
    },
    "product_detail_page": {
      "file": "src/components/ProductDetailPage.tsx",
      "sections": [
        "gallery",
        "price_and_purchase_panel",
        "shipping_address_card",
        "details_tabs",
        "similar_items_rail",
        "reviews_summary",
        "reviews_full_modal"
      ],
      "gallery_behavior": {
        "boxed_card_removed": true,
        "image_fit": "contain",
        "navigation": "pagination_dots_mobile_tablet_desktop_thumbnail_box",
        "drag_scroll_supported": true,
        "desktop_thumbnail_box": true,
        "tablet_thumbnail_box": false,
        "mobile_thumbnail_box": false
      },
      "cart_behavior": {
        "cta_color": "green",
        "quantity_control": [
          "trash_at_1",
          "minus_above_1",
          "center_count",
          "plus_on_right"
        ]
      }
    },
    "product_card": {
      "file": "src/components/ProductCard.tsx",
      "behaviors": [
        "open_product_detail",
        "favorite_toggle",
        "shared_quantity_control",
        "category_grid_reuse"
      ],
      "category_listing_compact_mode": {
        "shorter_than_homepage_rail": true,
        "image_priority": "square",
        "cart_control_position": "image_overlay_bottom_right",
        "price_row": "inline_compact",
        "delivery_time_badge_visible": false,
        "discount_badge_visible": true
      },
      "layout_alignment": {
        "equal_width_per_breakpoint": true,
        "shared_min_height_per_row": true,
        "reserved_internal_rows": [
          "badge_band",
          "brand_label",
          "title_block",
          "size_text",
          "unit_price_text",
          "price_and_action_footer"
        ],
        "title_clamp": 2,
        "trimmed_vertical_spacing": true
      },
      "badge_visibility": {
        "delivery_time_badge_visible": false,
        "discount_badge_visible": true
      },
      "quantity_css": {
        "stable_pill_width": true,
        "nowrap_text": true,
        "responsive_card_safe": true,
        "full_width_bottom_row": true
      }
    },
    "category_listing_page": {
      "file": "src/components/CategoryListingPage.tsx",
      "desktop_layout": "left_filter_sidebar_right_product_grid",
      "mobile_layout": "filter_drawer_plus_responsive_grid",
      "narrow_control_style": "small_inline_filter_sort_triggers",
      "sorting_behavior": "filter_first_then_sort_same_result_set_with_visible_grid_reorder",
      "grid_columns": {
        "desktop": 5,
        "tablet": 3,
        "mobile": 2
      },
      "initial_product_count_per_category": 60,
      "sorting_options": [
        "Featured (default)",
        "Best Selling",
        "Price: Low to High",
        "Price: High to Low"
      ],
      "filter_sections": [
        "Delivery type",
        "Product type",
        "Made in",
        "Price",
        "Price Range",
        "Brand"
      ]
    },
    "cart_page": {
      "file": "src/components/CartPage.tsx",
      "desktop_layout": "left_items_right_summary",
      "mobile_layout": "stacked_items_with_sticky_checkout_bar",
      "sticky_footer_spacing": "extra_bottom_reserve_when_footer_visible_below_xl",
      "free_shipping_threshold": 49,
      "desktop_shipping_strip": "slim_single_row_no_nested_progress_box",
      "quantity_control_style": "compact_green_stepper_pill",
      "behaviors": [
        "select_all",
        "item_selection",
        "remove_item",
        "save_for_later",
        "move_saved_to_cart",
        "free_shipping_progress",
        "checkout_auth_modal"
      ],
      "service_guarantee": {
        "payment_logo_style": "small_real_png_logos",
        "payment_logo_asset_folder": "public/assets/payment-icons",
        "guarantee_items": [
          "Global & Secure Payments",
          "Privacy Protection",
          "FoodOnlines.com Purchase Protection",
          "Speedy Delivery"
        ]
      }
    },
    "checkout_page": {
      "file": "src/components/CheckoutPage.tsx",
      "type": "responsive_placeholder",
      "sections": [
        "shipping_address_placeholder",
        "payment_method_placeholder",
        "selected_order_summary"
      ]
    },
    "header_search": {
      "file": "src/components/Header.tsx",
      "layout_preserved": true,
      "behaviors": [
        "shared_global_search_input",
        "camera_icon_removed",
        "submit_routes_to_search_results",
        "mobile_font_size_16px_minimum",
        "focus_without_mobile_browser_zoom"
      ]
    },
    "search_results_page": {
      "file": "src/components/SearchResultsPage.tsx",
      "card_reuse": "ProductCard",
      "behaviors": [
        "shared_cart_and_favorite_state",
        "open_product_detail_from_results",
        "responsive_grid_results",
        "friendly_empty_state"
      ]
    },
    "header_cart": {
      "file": "src/components/Header.tsx",
      "badge_behavior": [
        "shared_cart_total",
        "desktop_badge",
        "mobile_badge",
        "hide_when_zero",
        "route_to_cart_page"
      ]
    },
    "cart_quantity_control": {
      "file": "src/components/CartQuantityControl.tsx",
      "states": [
        "add_to_cart",
        "trash_at_quantity_one",
        "minus_above_one",
        "plus_increment"
      ],
      "visual_style": "green_pill"
    }
  },
  "responsive_rules": {
    "desktop": {
      "top_layout": "two_column",
      "gallery": "left",
      "purchase_panel": "sticky_right",
      "similar_items": "horizontal_multi_card"
    },
    "desktop_mobile_browser": {
      "top_layout": "collapse_without_overflow",
      "tabs": "horizontal_scroll",
      "reviews_modal": "resize_cleanly",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "filter_drawer_no_clipping",
      "cart_page": "summary_stacks_under_items"
    },
    "tablet": {
      "top_layout": "two_column_if_space_else_stack",
      "controls": "touch_friendly",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "three_column_grid",
      "cart_page": "two_column_if_room_else_stack"
    },
    "mobile": {
      "top_layout": "stacked",
      "gallery": "top",
      "reviews_view": "bottom_sheet_style",
      "product_cards": "equal_width_and_height_scroll_row",
      "category_listing": "two_column_grid_with_filter_drawer",
      "cart_page": "vertical_list_sticky_checkout_bar"
    }
  },
  "data_bindings": {
    "catalog_file": "src/data/home.ts",
    "store_file": "src/store/homeStore.ts",
    "category_slug_aliases": {
      "baby-care": "vegan-foods"
    },
    "asset_overrides": {
      "dairy_bread_mockup_folder": "public/assets/dairy-bread-mockups",
      "fruits_vegetables_mockup_folder": "public/assets/fruits-vegetables-mockups",
      "drinks_beverage_mockup_folder": "public/assets/drinks-beverage-mockups",
      "snacks_munchies_mockup_folder": "public/assets/snacks-munchies-mockups",
      "breakfast_instant_food_mockup_folder": "public/assets/breakfast-instant-food-mockups",
      "sweet_tooth_mockup_folder": "public/assets/sweet-tooth-mockups",
      "masala_oil_more_mockup_folder": "public/assets/masala-oil-more-mockups",
      "sauces_spreads_mockup_folder": "public/assets/sauces-spreads-mockups",
      "chicken_meat_fish_mockup_folder": "public/assets/chicken-meat-fish-mockups",
      "organic_healthy_living_mockup_folder": "public/assets/organic-healthy-living-mockups",
      "homepage_dairy_first_real_images": 15,
      "homepage_fruits_vegetables_first_real_images": 15,
      "homepage_drinks_beverage_first_real_images": 15,
      "homepage_snacks_munchies_first_real_images": 15,
      "homepage_breakfast_instant_food_first_real_images": 15,
      "homepage_sweet_tooth_first_real_images": 15,
      "homepage_masala_oil_more_first_real_images": 15,
      "homepage_sauces_spreads_first_real_images": 15,
      "homepage_chicken_meat_fish_first_real_images": 15,
      "homepage_organic_healthy_living_first_real_images": 15,
      "category_listing_fruits_vegetables_real_images": 60,
      "category_listing_drinks_beverage_real_images": 60,
      "category_listing_snacks_munchies_real_images": 60,
      "category_listing_breakfast_instant_food_real_images": 60,
      "category_listing_sweet_tooth_real_images": 60,
      "category_listing_masala_oil_more_real_images": 60,
      "category_listing_sauces_spreads_real_images": 60,
      "category_listing_chicken_meat_fish_real_images": 60,
      "category_listing_organic_healthy_living_real_images": 60,
      "sweet_tooth_packshots_before_screenshots": true,
      "category_listing_dairy_uses_remaining_images": true,
      "category_listing_fruits_vegetables_uses_remaining_images": true,
      "category_listing_drinks_beverage_uses_remaining_images": true,
      "category_listing_masala_oil_more_preserves_webp_slot_31": true,
      "real_image_overflow_fallback": "generated_unique_mock_art",
      "exact_duplicate_real_assets_removed": true
    },
    "search_fields": [
      "name",
      "categoryName",
      "brand",
      "provider",
      "tags",
      "badges",
      "size",
      "unitPrice",
      "country",
      "countryOfOrigin",
      "brandOrigin",
      "madeIn",
      "netContent",
      "quantity"
    ],
    "fields": [
