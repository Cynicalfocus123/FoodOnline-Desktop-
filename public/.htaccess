<IfModule mod_rewrite.c>
  Options -MultiViews -Indexes
  RewriteEngine On

  # Never turn a missing production asset into HTML. Module and media requests
  # must fail as real 404 responses so browsers do not cache index.html as a file.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/(?:assets|images)/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.[a-z0-9]{2,8}$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^admin(?:/.*)?$ admin.html [L]
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(?:index|admin|404)\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
